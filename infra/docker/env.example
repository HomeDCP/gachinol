# infra/docker/env.prod.example — 프로덕션 배포 env 템플릿.
#   cp infra/docker/env.prod.example infra/docker/.env.prod   그리고 값 채우기.
# .env.prod 는 .gitignore 처리됨(.env.*) — 시크릿 커밋 금지. 여기는 "이름/형식"만.
# 전체 env 표면은 루트 .env.example 참조. 아래는 프로덕션 필수·핵심만.
# 서비스 디스커버리(DATABASE_URL·REDIS_URL·AI_WORKER_URL)는 compose가 주입하므로 여기 두지 않는다.

# ── DB (compose가 이 값으로 postgres 컨테이너 기동 + api DATABASE_URL 조립) ──
POSTGRES_USER=gachinol
POSTGRES_PASSWORD=            # 강한 무작위 값 필수
POSTGRES_DB=gachinol

# ── 인증 (api fail-fast: 각 32자 이상, 서로 달라야 함) ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── 오브젝트 스토리지 = Cloudflare R2 (S3 호환) ──
# R2 엔드포인트: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (region은 auto)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=gachinol-media
S3_ACCESS_KEY=               # R2 API 토큰(Access Key ID)
S3_SECRET_KEY=               # R2 API 토큰(Secret Access Key)
S3_FORCE_PATH_STYLE=true
# 시청/다운로드 서명 URL이 향할 공개 호스트(R2 공개 도메인 또는 Cloudflare CDN 커스텀 도메인). 미설정 시 S3_ENDPOINT 사용.
S3_PUBLIC_ENDPOINT=

# ── 미디어 트랜스코딩 프로파일(media-worker; 기본값 있음 — 필요 시만 재정의) ──
# MEDIA_WORKER_CONCURRENCY=2
# MEDIA_RENDITION_HEIGHT=720
# MEDIA_RENDITION_VBR_KBPS=2500

# ── 시드 관리자(선택 — 최초 1회 `prisma db seed` 수동 실행 시에만) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── AI 워커 실 제공자(선택 — 미설정 시 결정적 스텁) ──
# AI_PROVIDER=openai
# OPENAI_API_KEY=

# ── SNS / 카카오 / PG (선택 — 실 어댑터 활성화 시. 미설정 시 목/비활성) ──
# 카카오는 직접 발행 API 없음(반자동 게시) — KAKAO_* 는 친구톡 대행 등 확장점. infrastructure.md §5-1
# KAKAO_REST_API_KEY=
# KAKAO_CHANNEL_ADMIN_KEY=
# YOUTUBE_API_KEY=
# META_PAGE_ACCESS_TOKEN=
# PG_PROVIDER=
# PG_API_KEY=
# PG_SECRET_KEY=

# ── 배포 태그/레지스트리(선택 — CI가 GHCR에 푸시한 이미지를 당길 때) ──
# REGISTRY=ghcr.io/homedcp
# IMAGE_TAG=latest
# API_PORT_PUBLISH=4000       # 역프록시 뒤라면 127.0.0.1:4000 로 바인딩 권장

# ── 웹 정적 서빙(`web`, docker-compose.xeon.yml, T-W0-03) — 도메인 미확정(G9 ①), 값 금지 ──
# 서브도메인 5종(watch./go./reporter./center./api.)의 상위 도메인. 미설정 시 gachinol.local로 대체되며
# 그 값과 일치하는 Host 헤더가 없어 안전하게 444(default_server)로 막힌다 — 실제론 아직 아무 도메인도
# 붙어 있지 않다. 확정 시 이 값만 채우면 nginx 재기동으로 반영(이미지 재빌드 불요 — 컨테이너 시작 시 치환).
# DOMAIN=
# web 컨테이너 LAN 노출 포트(선택, 기본 8081). 인터넷 노출과는 무관(아래 CLOUDFLARE_TUNNEL_TOKEN 참조).
# WEB_PORT_PUBLISH=8081
# 3앱 웹 번들에 빌드 시점 인라인되는 api 오리진(런타임 재정의 불가 — 값 바뀌면 web 이미지 재빌드 필요).
# 미설정 시 제온 LAN IP로 기본 동작(S3_PUBLIC_ENDPOINT와 동일 패턴).
# WEB_EXPO_PUBLIC_API_URL=

# ── 제온 외부 노출(Cloudflare Tunnel) — 미확정(G9 ②), 값 금지 ──
# 방식 자체가 미확정이라 docker-compose.xeon.yml의 cloudflared 서비스는 주석 처리돼 있다(설정만 준비,
# 실 연결 보류). Tunnel 채택이 확정되면 그 서비스 블록 주석 해제 + 아래 토큰 설정.
# CLOUDFLARE_TUNNEL_TOKEN=
