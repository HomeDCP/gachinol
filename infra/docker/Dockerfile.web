# infra/docker/Dockerfile.web — `web` 컨테이너: 3앱(subscriber·reporter·control-center)의
# `expo export --platform web` 정적 산출물을 만들어 nginx로 서빙한다 (T-W0-03, 골격).
#
# 빌드 컨텍스트 = 리포 루트 (pnpm 워크스페이스 전체 매니페스트 필요, api·media-worker Dockerfile과 동형):
#   docker build -f infra/docker/Dockerfile.web -t gachinol-web .
#
# 정적 자산 출처 설계(검토 요약은 완료 보고 참조) — **멀티스테이지 빌드 채택**(볼륨 마운트·CI 산출물
# 직접 주입 대신): 이 이미지 하나가 "소스 → 웹 정적 산출물"을 자기완결적으로 재현하므로, 후속
# T-W1-11c(`deploy-web.yml`)는 CI 러너에 3앱 빌드 툴체인을 따로 구성할 필요 없이 **이 Dockerfile을
# 빌드해 나오는 이미지 자체가 배포 단위**가 된다(기존 build-images.yml이 api·media-worker·ai-worker를
# GHCR에 푸시하는 것과 동일 패턴 — `docker compose ... pull && up`으로 배포).
ARG NODE_VERSION=24-bookworm-slim
ARG NGINX_VERSION=1.27-alpine

# ── base: corepack로 pnpm 8.15.0 고정 (api·media-worker Dockerfile과 동일 베이스) ──
FROM node:${NODE_VERSION} AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV CI=true
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate
WORKDIR /repo

# ── build: 의존 설치 → shared 빌드 → 3앱 web export ──
FROM base AS build
# 1) 매니페스트만 먼저 복사 → frozen-lockfile 정합(전체 워크스페이스 프로젝트 필요) + 설치 레이어 캐시
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY packages/shared/package.json packages/shared/
# packages/ui: 3앱이 `workspace:*`로 의존하는 디자인 토큰 레이어(T-W1-01, Wave 3). 소비가 0이던
# 구간에는 이 복사 없이도 빌드가 통과했으나, T-W1-02(Wave 5)가 subscriber에서 실제로 import를
# 시작하며 부재가 드러났다 — 워크스페이스 링크 대상이 없으면 `--frozen-lockfile` 설치부터 깨진다.
COPY packages/ui/package.json packages/ui/
COPY services/api/package.json services/api/
COPY services/media-worker/package.json services/media-worker/
COPY apps/reporter/package.json apps/reporter/
COPY apps/control-center/package.json apps/control-center/
COPY apps/subscriber/package.json apps/subscriber/
# 3앱 + 그 의존(shared)만 설치. --ignore-scripts: 공유 lockfile 탓에 install이 불필요한 패키지
# (api 테스트 전용 redis-memory-server 등)의 postinstall까지 돌려 이 이미지 빌드를 깨뜨리는 것을 막는다.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile \
      --filter @gachinol/reporter... \
      --filter @gachinol/control-center... \
      --filter @gachinol/subscriber... \
      --ignore-scripts
# 2) 소스 복사 후 shared 빌드(3앱이 소비하는 `@gachinol/shared`는 dist 산출물을 본다)
COPY tsconfig.base.json ./
COPY packages/shared/ packages/shared/
# packages/ui는 빌드 산출물이 없다(`main`이 `./src/tokens.ts` 소스를 직접 가리킨다) — 소스만 있으면 된다.
# 3앱의 `src/global.css`가 `packages/ui/src/tokens.css`를 @import하므로 CSS 경로 해석에도 이 복사가 필요하다.
COPY packages/ui/ packages/ui/
COPY apps/reporter/ apps/reporter/
COPY apps/control-center/ apps/control-center/
COPY apps/subscriber/ apps/subscriber/
RUN pnpm --filter @gachinol/shared build
# 3) 웹 export — EXPO_PUBLIC_* 는 빌드 시점에 번들에 인라인되므로(런타임 env 아님) build ARG로 받는다.
#    도메인 미확정(G9 ①)이라 하드코딩 금지 — compose가 build.args로 주입, 기본값은 로컬 검증용.
#
# ⚠️ **여기 없는 EXPO_PUBLIC_* 키는 어떤 배포로도 값이 들어가지 않는다**(대장 #146, T-W1-10 발견).
#    `.env.example`에 등재돼 있어도 이 파일과 `.github/workflows/deploy-web.yml`의 build-args를 함께
#    거치지 않으면 번들에 빈 값이 박힌다 — `EXPO_PUBLIC_SUPPORT_TEL`·`EXPO_PUBLIC_LIVE_YOUTUBE_URL`이
#    T-W2-28(#127) 이후 실제로 그 상태였고, "서버 값 우선 · env 폴백"의 폴백이 죽어 있었다.
#    **신규 EXPO_PUBLIC 키를 도입하는 태스크는 ⓐ `.env.example` ⓑ 이 파일 ⓒ deploy-web.yml
#    세 곳을 함께 갱신한다.** 기본값을 비워 두는 것은 의도적이다 — 앱이 빈 값을 "미설정"으로 보고
#    해당 UI를 숨기는 구조라(#127 선례), 가짜 기본값을 넣으면 죽은 버튼이 생긴다.
ARG EXPO_PUBLIC_API_URL=http://localhost:4000
ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL}
# 구독자 웹 — 재생 실패 폴백(#127) · 문의하기(T-W1-09) · 편성표 라이브 게시(T-W1-10)
ARG EXPO_PUBLIC_SUPPORT_TEL=
ENV EXPO_PUBLIC_SUPPORT_TEL=${EXPO_PUBLIC_SUPPORT_TEL}
ARG EXPO_PUBLIC_LIVE_YOUTUBE_URL=
ENV EXPO_PUBLIC_LIVE_YOUTUBE_URL=${EXPO_PUBLIC_LIVE_YOUTUBE_URL}
ARG EXPO_PUBLIC_KAKAO_CHANNEL_URL=
ENV EXPO_PUBLIC_KAKAO_CHANNEL_URL=${EXPO_PUBLIC_KAKAO_CHANNEL_URL}
ARG EXPO_PUBLIC_SUPPORT_EMAIL=
ENV EXPO_PUBLIC_SUPPORT_EMAIL=${EXPO_PUBLIC_SUPPORT_EMAIL}
ARG EXPO_PUBLIC_SUBSCRIBER_WEB_URL=
ENV EXPO_PUBLIC_SUBSCRIBER_WEB_URL=${EXPO_PUBLIC_SUBSCRIBER_WEB_URL}
ARG EXPO_PUBLIC_SCHEDULE_LIVE_HLS_URL=
ENV EXPO_PUBLIC_SCHEDULE_LIVE_HLS_URL=${EXPO_PUBLIC_SCHEDULE_LIVE_HLS_URL}
ARG EXPO_PUBLIC_SCHEDULE_LIVE_TITLE=
ENV EXPO_PUBLIC_SCHEDULE_LIVE_TITLE=${EXPO_PUBLIC_SCHEDULE_LIVE_TITLE}
RUN pnpm --filter @gachinol/subscriber exec expo export --platform web --output-dir dist \
 && pnpm --filter @gachinol/reporter exec expo export --platform web --output-dir dist \
 && pnpm --filter @gachinol/control-center exec expo export --platform web --output-dir dist

# ── runner: nginx만(Node/pnpm 런타임 미포함 — 정적 파일 서빙에 불필요) ──
# alpine 채택(api·media-worker의 bookworm-slim/glibc와 다름, 의도적 예외): 그 두 이미지가 glibc를 쓰는
# 이유는 argon2 네이티브 모듈·Prisma 쿼리엔진의 musl 불안정성 때문인데(CLAUDE.md §5), 이 런너는 Node를
# 아예 담지 않고 nginx가 정적 파일만 서빙한다 — musl/glibc 차이가 적용될 네이티브 바이너리 자체가 없다.
# alpine의 작은 풋프린트가 제온 오버레이의 낮은 메모리 리밋(docker-compose.xeon.yml)과 더 잘 맞는다.
FROM nginx:${NGINX_VERSION} AS runner
# 컨테이너 시작 시 envsubst로 채워질 템플릿으로 둔다(빌드 시점 고정이 아니라 런타임 치환 — 도메인 미확정
# 대응, G9 ①). nginx:alpine 이미지는 자체 템플릿 기능용으로 gettext(envsubst)를 이미 포함한다.
COPY infra/docker/nginx.conf /etc/nginx/nginx.conf.template
COPY --from=build /repo/apps/subscriber/dist /usr/share/nginx/html/watch
COPY --from=build /repo/apps/reporter/dist /usr/share/nginx/html/reporter
COPY --from=build /repo/apps/control-center/dist /usr/share/nginx/html/center
# 기본값 — compose environment.DOMAIN 미설정 시에도 컨테이너가 뜨도록(전부 매칭 실패해도 default_server
# catch-all(444)이 받아 안전하게 죽는다 — placeholder 도메인이 실제 트래픽을 잘못 받을 위험 없음).
ENV DOMAIN=gachinol.local
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1
# envsubst 허용목록을 '${DOMAIN} ${TUNNEL_HOST}' 둘로 제한 — nginx 자체 변수($host·$connection_upgrade 등,
# 소문자·중괄호 없음)는 이 목록과 매칭되지 않아 그대로 보존된다(표준 관용구, 공식 nginx 이미지의
# 20-envsubst-on-templates.sh와 동형). TUNNEL_HOST는 Quick Tunnel 임시 호스트 1개를 허용하는 vhost용이며
# 미설정 시 compose가 도달 불가능한 기본값(tunnel.invalid)을 주입해 노출이 열리지 않게 한다.
CMD ["/bin/sh", "-c", "envsubst '${DOMAIN} ${TUNNEL_HOST}' < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf && exec nginx -g 'daemon off;'"]
