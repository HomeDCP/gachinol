# infra/backup/gachinol-backup.service — 대장 #153
# 설치·확인 절차는 gachinol-backup.timer 헤더 참조.

[Unit]
Description=gachinol 미디어·DB 백업 실행
# NAS 마운트가 준비된 뒤에 돈다. 마운트가 없으면 스크립트가 즉시 실패하므로 이중 방어다
# (로컬 디스크에 백업을 쌓아 디스크를 채우는 사고를 막는다).
RequiresMountsFor=/mnt/gachinol-backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ★ root로 돈다 — 실측 근거가 있다(2026-08-22).
#   MinIO 데이터 디렉터리는 `drwx------ root root`이고(컨테이너가 root로 쓴다) 일반 계정으로
#   `rsync`하면 **code 23**(`some files/attrs were not transferred`)으로 죽는다.
#   백업은 본질적으로 전량 읽기 권한을 요구하므로 여기서 권한을 낮추면 "부분만 백업되는데
#   종료 코드는 성공"이라는 최악의 형태가 되기 쉽다. 대신 쓰기 범위를 좁힌다:
#   NAS 자격증명은 백업 전용 계정이고 그 공유에만 쓰기 권한을 준다(README ①).
WorkingDirectory=/opt/gachinol
# 값은 환경설정 파일에서 로드한다(자격증명·경로 하드코딩 금지).
# `-`(대시)는 파일이 없어도 서비스가 실패하지 않게 한다 — 스크립트가 자체 기본값을 갖는다.
EnvironmentFile=-/opt/gachinol/infra/docker/backup.env
ExecStart=/opt/gachinol/infra/backup/media-to-nas.sh
# 실패를 조용히 넘기지 않는다 — journalctl -u gachinol-backup 에 남는다
StandardOutput=journal
StandardError=journal
# 백업이 호스트를 잡아먹지 않도록(트랜스코딩과 겹칠 수 있다)
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
