    "fluent-ffmpeg": "^2.1.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/jest": "^29",
    "@types/node": "^24",
    "jest": "^29",
    "ts-jest": "^29",
    "tsx": "^4",
    "typescript": "~5.9.0"
  }
