{
  "name": "@gachinol/media-worker",
  "version": "0.1.0",
  "private": true,
  "description": "가치놀 미디어 워커 — BullMQ FFmpeg 트랜스코딩·프리뷰·썸네일 (DB·API토큰 없음, S3만)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gachinol/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.700.0",
