// 규약: 테이블·컬럼 snake_case(@map/@@map), enum성 컬럼은 전부 String(text) —
// 값은 @gachinol/shared의 snake_case 문자열 그대로 (Prisma enum·CHECK 제약 금지, 검증은 앱 경계).
// ID는 앱이 UUID v7 발급 (시간순 정렬·커서 겸용). 타임스탬프는 timestamptz(3).
// 이번 범위 밖 도메인(커머스·라이브) 테이블 선반영 금지.
// media_assets는 media-worker 연동 단계에서 도입됨(아래 model MediaAsset).
// channel_accounts·publications는 다채널 송출 슬라이스에서 도입됨(아래 model ChannelAccount·Publication).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Station {
  id           String    @id
  code         String    @unique // slug: 'center' | 'aewol' | 'jeju-si' ...
  name         String
  kind         String // StationKind: 'center' | 'branch'
  status       String // StationStatus: 'operating' | 'dormant' | 'planned'
  region       String
  description  String?
  thumbnailUrl String?   @map("thumbnail_url")
  sortOrder    Int       @default(0) @map("sort_order")
  foundedAt    DateTime? @map("founded_at") @db.Date
  dormantSince DateTime? @map("dormant_since") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  users           User[]
  contents        Content[]
  channelAccounts ChannelAccount[]

  @@index([kind, status])
  @@map("stations")
}

model User {
  id              String   @id
  role            String // UserRole (shared snake_case)
  name            String
  email           String?  @unique // 소셜 전용 구독자 대비 nullable
  phone           String?
  profileImageUrl String?  @map("profile_image_url")
  status          String   @default("active") // UserStatus
  stationId       String?  @map("station_id") // 불변식: role='reporter' ⇒ 필수 (서비스 강제)
  passwordHash    String?  @map("password_hash") // argon2id. 소셜 전용이면 null
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  station          Station?       @relation(fields: [stationId], references: [id])
  refreshTokens    RefreshToken[]
  reportedContents Content[]      @relation("ContentReporter")
  approvedContents Content[]      @relation("ContentApprover")

  @@index([role, stationId])
  @@map("users")
}

// 인증 인프라 테이블 (도메인 아님 — shared 계약 밖) — refresh 회전·재사용 탐지용
model RefreshToken {
  id           String    @id // = JWT jti
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash") // sha256(refresh JWT) — 원문 저장 금지
  familyId     String    @map("family_id") // 로그인 1회 = family 1개. 재사용 탐지 시 일괄 폐기
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") // 회전 계보
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Content {
  id                      String    @id
  stationId               String    @map("station_id")
  origin                  String    @default("reporter_upload") // ContentOrigin
  reporterId              String?   @map("reporter_id") // 불변식: origin='reporter_upload' ⇔ non-null (서비스 강제)
  title                   String
  description             String?
  category                String // ProgramCategory
  cultureTopics           String[]  @default([]) @map("culture_topics") // CultureTopic[] — culture일 때만 non-empty
  status                  String    @default("draft") // ContentStatus 23종
  priority                String    @default("normal") // ContentPriority
  reviewPolicy            String    @map("review_policy") // ReviewPolicy
  generation              Int       @default(1)
  scenes                  Json      @default("[]") // wire Scene[] 그대로 (JSONB, 키 camelCase)
  targetChannelAccountIds String[]  @default([]) @map("target_channel_account_ids") // FK 없음 — channel_accounts 미도입
  tags                    String[]  @default([])
  remakeOfContentId       String?   @map("remake_of_content_id")
  lastError               Json?     @map("last_error") // { message, at }
  durationSec             Int?      @map("duration_sec")
  approvedByUserId        String?   @map("approved_by_user_id")
  approvedAt              DateTime? @map("approved_at") @db.Timestamptz(3)
  publishedAt             DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  station          Station           @relation(fields: [stationId], references: [id])
  reporter         User?             @relation("ContentReporter", fields: [reporterId], references: [id])
  approvedBy       User?             @relation("ContentApprover", fields: [approvedByUserId], references: [id])
  revisionRequests RevisionRequest[]
  mediaAssets      MediaAsset[]
  aiAnalyses       AiAnalysis[]
  publications     Publication[]

  @@index([stationId, status, publishedAt(sort: Desc)]) // shared 권고: "지사별 최신 송출"
  @@index([stationId, createdAt(sort: Desc)]) // 지사별 목록
  @@index([reporterId, createdAt(sort: Desc)]) // 기자 내 목록
  @@index([status, createdAt(sort: Desc)]) // 관제 전체 상태판
  @@map("contents")
}

model RevisionRequest {
  id                String    @id
  targetKind        String    @map("target_kind") // RevisionTarget.kind — phase-1은 'content'만
  contentId         String?   @map("content_id")
  recommendationId  String?   @map("recommendation_id") // FK 없음 (테이블 미도입)
  requestedByUserId String    @map("requested_by_user_id")
  requesterRole     String    @map("requester_role") // RevisionRequesterRole
  message           String
  sceneNotes        Json?     @map("scene_notes") // { sceneId, note }[]
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedByJobId   String?   @map("resolved_by_job_id") // BullMQ jobId 문자열 (jobs 테이블 없음)

  content Content? @relation(fields: [contentId], references: [id])

  @@index([contentId, createdAt(sort: Desc)])
  @@map("revision_requests")
}

model MediaAsset {
  id             String   @id
  ownerKind      String   @map("owner_kind") // MediaAssetOwner.kind: 'content' (라이브는 미도입)
  contentId      String?  @map("content_id")
  kind           String // MediaAssetKind (shared snake_case)
  status         String   @default("pending") // MediaAssetStatus
  generation     Int      @default(1) // Content.generation 대응 (original은 항상 1)
  bucket         String // 항상 해석된 실 버킷 저장 — (bucket, storageKey) unique 성립 위해 non-null
  storageKey     String   @map("storage_key") // 'contents/{contentId}/g{n}/...'
  mimeType       String   @map("mime_type")
  sizeBytes      BigInt?  @map("size_bytes") // 영상은 Int(2.1GB) 초과 가능 → BigInt. 매퍼에서 Number()
  durationSec    Int?     @map("duration_sec")
  width          Int?
  height         Int?
  bitrateKbps    Int?     @map("bitrate_kbps")
  videoCodec     String?  @map("video_codec")
  audioCodec     String?  @map("audio_codec")
  renditionLabel String?  @map("rendition_label")
  checksumSha256 String?  @map("checksum_sha256")
  createdByJobId String?  @map("created_by_job_id") // BullMQ jobId (jobs 테이블 없음)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  content Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([bucket, storageKey]) // ★ 멱등 생성 가드 + upsert 키 (QueueEvents 다중 수신에도 1행)
  @@index([contentId, kind, generation]) // "이 콘텐츠 현 세대 프리뷰/썸네일" 단건 조회 최빈
  @@map("media_assets")
}

// AI 분석 결과 — ai-worker HTTP(/analyze) 산출물의 유일 DB 기록처(AiAnalysesService가 유일 기록자).
// MediaAsset 동형: enum성 없음, vision/text/modelInfo는 구조적 JSON(Json?, scenes/last_error 선례).
// (content_id, generation) unique = 멱등 upsert 키(QueueEvents 다중 수신·리컨사일에도 1행).
model AiAnalysis {
  id                  String    @id
  contentId           String    @map("content_id")
  generation          Int       @default(1) // Content.generation 대응
  vision              Json? // wire VisionAnalysis (camelCase)
  text                Json?     @map("text_analysis") // wire TextAnalysis
  recommendationScore Float?    @map("recommendation_score") // 0~1
  modelInfo           Json?     @map("model_info")
  createdByJobId      String?   @map("created_by_job_id") // BullMQ jobId (jobs 테이블 없음)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(3)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, generation]) // ★ 멱등 upsert 키 (재수신·리컨사일 하드 가드)
  @@index([contentId, generation]) // "이 콘텐츠 현 세대 분석" 단건 조회
  @@map("ai_analyses")
}

// 송출 채널 계정 — 지사별 카톡채널 + 센터 SNS 계정들이 이 테이블의 행.
// enum성 없음(platform·status는 shared snake_case 문자열). credential_ref는 시크릿 저장소 키 '이름만'.
model ChannelAccount {
  id                String    @id
  platform          String // Platform (kakao/youtube/…)
  stationId         String?   @map("station_id") // 지사 소유면 지사 id, null = 센터 공용 SNS
  name              String // 예: '애월 마을방송국 카카오톡 채널'
  externalChannelId String    @map("external_channel_id") // 플랫폼 측 채널 id
  credentialRef     String    @map("credential_ref") // ★ 시크릿 저장소 키 이름만 — 토큰값 저장 금지
  capabilities      String[]  @default([]) // ChannelCapability[] — 카톡='vod_publish'
  status            String    @default("connected") // ChannelAccountStatus
  connectedAt       DateTime? @map("connected_at") @db.Timestamptz(3)
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  station      Station?      @relation(fields: [stationId], references: [id])
  publications Publication[]

  @@unique([platform, externalChannelId]) // shared: "(platform, externalChannelId) unique"
  @@index([stationId, platform, status]) // 기본 송출처 해석("지사 X의 connected kakao 채널") 핫패스
  @@map("channel_accounts")
}

// 송출 기록: (소스 × 채널) 1건. 재송출은 새 행(이력 보존). Content 상태와 독립된 채널 단위 상태머신.
// live_session_id는 FK 없는 nullable 예약(live_sessions 미도입) — 이번 슬라이스는 항상 source_kind='content'.
// requested_by_user_id는 FK 없음(StatusTransitionLog.actorUserId 선례, null=시스템).
// ★ 부분 유니크(멱등 하드가드)는 Prisma 미지원 → 마이그레이션 수기 SQL:
//   UNIQUE (content_id, channel_account_id) WHERE status IN ('queued','publishing','published') AND content_id IS NOT NULL
//   (failed/retracted/canceled 제외 → 재송출은 새 행 허용).
model Publication {
  id                String    @id
  sourceKind        String    @map("source_kind") // PublicationSource.kind — 항상 'content'
  contentId         String?   @map("content_id") // source=content일 때. FK→contents Cascade
  liveSessionId     String?   @map("live_session_id") // FK 없음(live 미도입) — 항상 null
  channelAccountId  String    @map("channel_account_id") // FK→channel_accounts Restrict
  platform          String // 채널서 복사 비정규화(조회 편의)
  status            String    @default("queued") // PublicationStatus 6종
  externalPostId    String?   @map("external_post_id")
  externalUrl       String?   @map("external_url")
  attempts          Int       @default(0)
  errorMessage      String?   @map("error_message")
  requestedByUserId String?   @map("requested_by_user_id") // FK 없음. null=시스템
  queuedAt          DateTime  @default(now()) @map("queued_at") @db.Timestamptz(3)
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(3)
  retractedAt       DateTime? @map("retracted_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  content        Content?       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Restrict)

  @@index([contentId, createdAt(sort: Desc)]) // GET /contents/:id/publications + ContentDetail
  @@index([status]) // 관제/리컨사일 스캔
  @@map("publications")
}

model StatusTransitionLog {
  id          String   @id
  entityType  String   @map("entity_type") // TransitionEntityType
  entityId    String   @map("entity_id") // 다형 참조 — FK 없음 (shared 규약)
  fromStatus  String   @map("from_status")
  toStatus    String   @map("to_status")
  actorType   String   @map("actor_type") // ActorType: 'user' | 'system'
  actorUserId String?  @map("actor_user_id") // 불변식: actorType='user' ⇒ 필수 (서비스 강제)
  jobId       String?  @map("job_id")
  note        String?
  at          DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, at(sort: Desc)]) // shared 권고: 상세 "이력" 탭
  @@map("status_transition_logs")
}
