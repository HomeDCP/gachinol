// 규약: 테이블·컬럼 snake_case(@map/@@map), enum성 컬럼은 전부 String(text) —
// 값은 @gachinol/shared의 snake_case 문자열 그대로 (Prisma enum·CHECK 제약 금지, 검증은 앱 경계).
// ID는 앱이 UUID v7 발급 (시간순 정렬·커서 겸용). 타임스탬프는 timestamptz(3).
// 이번 범위 밖 도메인(media_assets·publications·channel_accounts·커머스·라이브) 테이블 선반영 금지.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Station {
  id           String    @id
  code         String    @unique // slug: 'center' | 'aewol' | 'jeju-si' ...
  name         String
  kind         String // StationKind: 'center' | 'branch'
  status       String // StationStatus: 'operating' | 'dormant' | 'planned'
  region       String
  description  String?
  thumbnailUrl String?   @map("thumbnail_url")
  sortOrder    Int       @default(0) @map("sort_order")
  foundedAt    DateTime? @map("founded_at") @db.Date
  dormantSince DateTime? @map("dormant_since") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  users    User[]
  contents Content[]

  @@index([kind, status])
  @@map("stations")
}

model User {
  id              String   @id
  role            String // UserRole (shared snake_case)
  name            String
  email           String?  @unique // 소셜 전용 구독자 대비 nullable
  phone           String?
  profileImageUrl String?  @map("profile_image_url")
  status          String   @default("active") // UserStatus
  stationId       String?  @map("station_id") // 불변식: role='reporter' ⇒ 필수 (서비스 강제)
  passwordHash    String?  @map("password_hash") // argon2id. 소셜 전용이면 null
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  station          Station?       @relation(fields: [stationId], references: [id])
  refreshTokens    RefreshToken[]
  reportedContents Content[]      @relation("ContentReporter")
  approvedContents Content[]      @relation("ContentApprover")

  @@index([role, stationId])
  @@map("users")
}

// 인증 인프라 테이블 (도메인 아님 — shared 계약 밖) — refresh 회전·재사용 탐지용
model RefreshToken {
  id           String    @id // = JWT jti
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash") // sha256(refresh JWT) — 원문 저장 금지
  familyId     String    @map("family_id") // 로그인 1회 = family 1개. 재사용 탐지 시 일괄 폐기
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") // 회전 계보
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Content {
  id                      String    @id
  stationId               String    @map("station_id")
  origin                  String    @default("reporter_upload") // ContentOrigin
  reporterId              String?   @map("reporter_id") // 불변식: origin='reporter_upload' ⇔ non-null (서비스 강제)
  title                   String
  description             String?
  category                String // ProgramCategory
  cultureTopics           String[]  @default([]) @map("culture_topics") // CultureTopic[] — culture일 때만 non-empty
  status                  String    @default("draft") // ContentStatus 23종
  priority                String    @default("normal") // ContentPriority
  reviewPolicy            String    @map("review_policy") // ReviewPolicy
  generation              Int       @default(1)
  scenes                  Json      @default("[]") // wire Scene[] 그대로 (JSONB, 키 camelCase)
  targetChannelAccountIds String[]  @default([]) @map("target_channel_account_ids") // FK 없음 — channel_accounts 미도입
  tags                    String[]  @default([])
  remakeOfContentId       String?   @map("remake_of_content_id")
  lastError               Json?     @map("last_error") // { message, at }
  durationSec             Int?      @map("duration_sec")
  approvedByUserId        String?   @map("approved_by_user_id")
  approvedAt              DateTime? @map("approved_at") @db.Timestamptz(3)
  publishedAt             DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  station          Station           @relation(fields: [stationId], references: [id])
  reporter         User?             @relation("ContentReporter", fields: [reporterId], references: [id])
  approvedBy       User?             @relation("ContentApprover", fields: [approvedByUserId], references: [id])
  revisionRequests RevisionRequest[]

  @@index([stationId, status, publishedAt(sort: Desc)]) // shared 권고: "지사별 최신 송출"
  @@index([stationId, createdAt(sort: Desc)]) // 지사별 목록
  @@index([reporterId, createdAt(sort: Desc)]) // 기자 내 목록
  @@index([status, createdAt(sort: Desc)]) // 관제 전체 상태판
  @@map("contents")
}

model RevisionRequest {
  id                String    @id
  targetKind        String    @map("target_kind") // RevisionTarget.kind — phase-1은 'content'만
  contentId         String?   @map("content_id")
  recommendationId  String?   @map("recommendation_id") // FK 없음 (테이블 미도입)
  requestedByUserId String    @map("requested_by_user_id")
  requesterRole     String    @map("requester_role") // RevisionRequesterRole
  message           String
  sceneNotes        Json?     @map("scene_notes") // { sceneId, note }[]
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedByJobId   String?   @map("resolved_by_job_id") // BullMQ jobId 문자열 (jobs 테이블 없음)

  content Content? @relation(fields: [contentId], references: [id])

  @@index([contentId, createdAt(sort: Desc)])
  @@map("revision_requests")
}

model StatusTransitionLog {
  id          String   @id
  entityType  String   @map("entity_type") // TransitionEntityType
  entityId    String   @map("entity_id") // 다형 참조 — FK 없음 (shared 규약)
  fromStatus  String   @map("from_status")
  toStatus    String   @map("to_status")
  actorType   String   @map("actor_type") // ActorType: 'user' | 'system'
  actorUserId String?  @map("actor_user_id") // 불변식: actorType='user' ⇒ 필수 (서비스 강제)
  jobId       String?  @map("job_id")
  note        String?
  at          DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, at(sort: Desc)]) // shared 권고: 상세 "이력" 탭
  @@map("status_transition_logs")
}
