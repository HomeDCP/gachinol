{
  // 순서 중요: 뒤가 이긴다 — RN 필수 옵션(jsx·lib 등)은 expo 프리셋이 확정
  "extends": ["../../tsconfig.base.json", "expo/tsconfig.base"],
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // 루트 강성 옵션 재확정 (expo 프리셋이 완화해도 유지)
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["jest"]
  },
  // expo-env.d.ts는 SDK 54에서 불요 — expo/tsconfig.base가 expo/types를 직접 참조한다.
  // (expo start가 이 include를 자동 정리하며 주석까지 지우므로, 지워지면 여기서 되살릴 것)
  "include": ["app", "src", "app.config.ts"]
}
