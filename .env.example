# ─────────────────────────────────────────────────────────
# Gachinol 환경변수 예시  —  복사해서 .env 로 쓰세요 (.env 는 커밋 금지)
#   cp .env.example .env
# 실제 시크릿은 절대 이 파일에 넣지 마세요. 여기는 "키 목록"만.
# ─────────────────────────────────────────────────────────

# ── 공통 ──
NODE_ENV=development

# ── API 서버 (services/api) ──
API_PORT=4000
API_BASE_URL=http://localhost:4000

# ── 데이터베이스 (PostgreSQL) ──
# 개발용 DB. e2e 테스트는 전용 DB(gachinol_test — 이름에 'test' 필수)를 자동 사용/생성한다.
DATABASE_URL=postgresql://gachinol:gachinol@localhost:5432/gachinol

# ── Redis (큐 / 캐시 / 실시간 pub-sub) ──
REDIS_URL=redis://localhost:6379

# ── 오브젝트 스토리지 (영상 원본·트랜스코딩; S3 호환 / 로컬은 MinIO) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-northeast-2
S3_BUCKET=gachinol-media
# 실사용 시크릿(값은 .env에만). 미설정 시 업로드 기능만 비활성(부팅은 성공)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# 실기기 presign 호스트 분리 — 미설정 시 S3_ENDPOINT 사용 (예: http://<LAN-IP>:9000)
S3_PUBLIC_ENDPOINT=
S3_PRESIGN_EXPIRES_SEC=900
DOWNLOAD_URL_TTL_SEC=900

# ── 버킷 CORS (T-W0-02 — 브라우저 presigned PUT 업로드 + GET 재생 오리진 화이트리스트) ──
# infra/scripts/r2-cors.ts(R2 대상 — 버킷 단위 PutBucketCors)와 infra/docker-compose.yml의
# MINIO_API_CORS_ALLOW_ORIGIN(로컬 MinIO 대상 — 서버 전역 설정, 메커니즘이 다름) 양쪽이 이 값을 공유한다.
# 콤마 구분 오리진 목록. 도메인 미확정(02§D-T5 서브도메인 5종 확정 전) 구간은 로컬 웹 dev 오리진만 기본값.
# GACHINOL_DOMAIN(아래 모니터링 섹션) 확정 후에는 watch./go./reporter./center.<GACHINOL_DOMAIN> 4종
# (api.는 버킷에 직접 접근하지 않아 제외)을 이 목록에 콤마로 추가한다 — 자동 파생 아님, 수동 갱신.
S3_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# 콤마 구분. 기본값은 R2 AllowedHeaders 와일드카드('*') 프리플라이트 버그 회피용 명시 헤더.
S3_CORS_ALLOWED_HEADERS=content-type,range
S3_CORS_MAX_AGE_SEC=3600

# ── 미디어 파이프라인 (api ↔ media-worker; BullMQ 잡 옵션·트랜스코딩/프리뷰 프로파일) ──
MEDIA_JOB_ATTEMPTS=3
MEDIA_JOB_BACKOFF_MS=5000
MEDIA_RENDITION_HEIGHT=720
MEDIA_PREVIEW_HEIGHT=360
MEDIA_PREVIEW_BITRATE_KBPS=600
# 아래는 media-worker 전용 (트랜스코딩·썸네일 프로파일)
MEDIA_RENDITION_VBR_KBPS=2500
MEDIA_WORKER_CONCURRENCY=2
# FFmpeg 무진행 워치독(ms) — 초과 시 SIGKILL 후 잡 실패 처리(hang 방어). 기본 30분
MEDIA_FFMPEG_TIMEOUT_MS=1800000
MEDIA_THUMBNAIL_WIDTH=640
MEDIA_THUMBNAIL_AT_SEC=1

# ── 인증 (JWT) — access/refresh 시크릿 분리 (서로 달라야 함, 각 32자 이상) ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=900s
JWT_REFRESH_EXPIRES_IN=14d

# ── 웹 오리진 화이트리스트 (api CORS + 쿠키 refresh 경로의 CSRF 오리진 검증, 02§E-2) ──
# 콤마(또는 공백) 구분 오리진 목록. 미설정 = 브라우저 크로스오리진 **전면 차단**이며
# 쿠키 세션 경로(/v1/auth/web/*)도 함께 닫힌다(안전 기본값). '*'는 허용하지 않는다.
# ⚠️ 이 키는 아직 services/api env 스키마(zod) 밖이라 **프로세스 환경변수로 주입해야** 도달한다
#    (셸 export·docker `environment:`/`env_file:` OK / 이 파일을 .env로 복사만 하면 미반영).
WEB_ORIGINS=

# ── DB 컨테이너 (infra/docker-compose.yml) ──
POSTGRES_USER=gachinol
POSTGRES_PASSWORD=gachinol
POSTGRES_DB=gachinol

# ── 시드 관리자 계정 (prisma db seed 전용 — 미설정 시 시드 실패) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── 기자 앱 (apps/reporter — Expo) ──
# EXPO_PUBLIC_* 는 앱 번들에 그대로 인라인되는 공개 값 — 시크릿 금지.
# Expo는 루트 .env를 읽지 않는다 — apps/reporter/.env 에 설정 (실기기는 개발 머신 LAN IP).
EXPO_PUBLIC_API_URL=http://localhost:4000

# ── 센터 관제 앱 (apps/control-center — Expo) ──
# 변수명은 기자 앱과 동일한 EXPO_PUBLIC_API_URL. Expo는 앱별 .env를 읽으므로
# apps/control-center/.env 에 별도로 둔다 (값은 위와 공유, 새 시크릿 없음).

# ── 구독자 앱 (apps/subscriber — Expo) ──
# 익명 시청 — 동일한 EXPO_PUBLIC_API_URL. apps/subscriber/.env 에 둔다 (값 공유, 새 시크릿 없음).
# 라이브 WS(채팅·프롬프터)는 REST와 동일 오리진(EXPO_PUBLIC_API_URL)을 socket.io가 그대로 사용한다
# — 별도 EXPO_PUBLIC_WS_URL 불필요(http(s) 오리진에서 자동 업그레이드).

# ── AI 워커 (services/ai-worker, Python/FastAPI) ──
# AI_WORKER_URL: api가 ai-worker를 찾는 주소(api가 읽음). ai-worker 자신은 미사용.
# 미설정 시 분석 홉 비활성 → transcode 완료가 preview_generating 직행(무회귀 폴백).
AI_WORKER_URL=http://localhost:8000
# api 분석 홉 잡 옵션 (api가 읽음)
AI_WORKER_TIMEOUT_MS=120000
AI_ANALYSIS_JOB_ATTEMPTS=3
AI_ANALYSIS_JOB_BACKOFF_MS=5000
AI_ANALYSIS_CONCURRENCY=4
# ai-worker 전용(Python) — api env.schema 미포함
AI_PROVIDER=
AI_WORKER_PORT=
AI_VISION_MODEL=
AI_STT_MODEL=
OPENAI_API_KEY=
# 또는 자체/타 벤더 비전·STT 엔드포인트

# ── 라이브 스트리밍 (RTMP ingest / HLS 배포 — 자체 또는 Mux/AWS IVS) ──
# 실 인프라 미구축 — 미설정 시 플레이스홀더 URL 합성(WS 채팅·프롬프터·프레즌스는 상시 동작).
LIVE_RTMP_INGEST_URL=
LIVE_HLS_PLAYBACK_URL=
# dev 스트림키 플레이스홀더(미설정 시 'dev-'+세션id 합성). 프로덕션 시크릿 아님 — 이름만 노출.
LIVE_DEV_STREAM_KEY=
# 라이브+WS 튜닝(전부 기본값 있음 — 미설정 시 기본 사용). WS 게이트웨이는 상시 활성(코어).
# 다중 인스턴스 socket.io fan-out만 REDIS_URL 게이트(미설정=단일 인스턴스 우아한 저하).
LIVE_COMMENT_POLL_INTERVAL_MS=3000
LIVE_COMMENT_BATCH_MAX=50
LIVE_CHAT_MESSAGE_MAX_LEN=500
LIVE_CHAT_RECENT_LIMIT=50
LIVE_CHAT_RATE_CAPACITY=5
LIVE_CHAT_RATE_REFILL_MS=2000

# ── 다채널 송출 / 댓글 수집 (SNS) ──
# 카카오톡 채널 — 둘 다 설정 시에만 실 카카오 어댑터 주입(아니면 목이 배포 기본). 값은 .env에만.
KAKAO_REST_API_KEY=
KAKAO_CHANNEL_ADMIN_KEY=
# 송출 잡 옵션 (api가 읽음 — 큐 게이트는 REDIS_URL만, 카카오 목이 기본)
PUBLISH_JOB_ATTEMPTS=3
PUBLISH_JOB_BACKOFF_MS=5000
PUBLISH_CONCURRENCY=4
# YouTube (Live + 댓글)
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Meta (Facebook / Instagram Graph API)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
# X (구 Twitter)
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
# Threads
THREADS_ACCESS_TOKEN=

# ── 주간 콘텐츠 추천 (api 인프로세스 — 신규 시크릿 0) ──
# 큐 게이트는 REDIS_URL 단독(계산이 순수 로컬 DB 집계라 외부 URL 불요).
# 미설정 시 생성 요청이 인라인 계산으로 폴백한다(generating 고착 방지).
RECOMMENDATION_TOP_N=7
RECOMMENDATION_JOB_ATTEMPTS=3
RECOMMENDATION_JOB_BACKOFF_MS=5000
RECOMMENDATION_CONCURRENCY=2
# 고착 복구 임계(ms) — generating|regenerating이 이보다 오래 머물면 재요청이 강제 실패 후 재시도한다.
RECOMMENDATION_STUCK_MS=600000

# ── DCP 상호배제 아비터 (제온 호스트를 DCP 파이프라인과 공유할 때만) ──
# 미설정 시 완전 비활성 = 미디어 큐 상시 가동(로컬·클라우드 배포는 이 블록 전체 불필요).
# 설정 시 api가 DCP api를 GET으로만 조회해(읽기 전용) DCP가 CPU를 쓰는 동안 미디어 큐를 정지한다.
# bridge 컨테이너에서 호스트 루프백에 닿아야 하므로 host.docker.internal 사용(compose extra_hosts 필요).
DCP_ARBITER_URL=
# SSE(/api/stream) 순단 대비 폴백 폴링 주기
DCP_ARBITER_POLL_MS=30000
DCP_ARBITER_TIMEOUT_MS=5000
# 활성 잡이 없는데 대기 잡이 있으면 미리 양보할지(true/false만 허용). 계약 변경 시 킬스위치
DCP_ARBITER_HOLD_ON_IMMINENT=true
# DCP api 조회 실패 시: hold(보수적·DCP 우선) | run(가용성 우선)
DCP_ARBITER_FAIL_MODE=hold

# ── 결제 (라이브커머스 PG) ──
PG_PROVIDER=
PG_API_KEY=
PG_SECRET_KEY=

# ── 백업 (PG→R2/MinIO 일일 덤프; infra/backup/pg-dump-to-r2.sh, T-W0-04 — 08§B) ──
# 미설정 키는 기존 S3_* 로 폴백(별도 값 필요할 때만 오버라이드). 값은 .env에만.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=gachinol-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=
# 보존 기간(일) — 08§B "보존 30일"
BACKUP_RETENTION_DAYS=30
# 실패 시 알림(Slack/Discord 호환 webhook). 미설정 시 알림 생략(로그만).
BACKUP_ALERT_WEBHOOK_URL=
# docker exec 대상 컨테이너명(선택 — 미설정 시 compose 라벨로 자동 탐색)
POSTGRES_CONTAINER=

# ── 모니터링 (infra/monitoring/uptime-kuma-config.yml, T-W0-04 — 08§B) ──
# Kuma 실패 알림 webhook. BACKUP_ALERT_WEBHOOK_URL과 같은 값을 재사용해도 무방(운영 판단).
UPTIME_KUMA_ALERT_WEBHOOK_URL=
# 배포 도메인 확정 전까지 공란(08§E "사용자 결정 3건" ①과 동일 미정 항목)
GACHINOL_DOMAIN=
