{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".expo/**"],
      "env": ["EXPO_PUBLIC_*", "S3_*", "REDIS_URL", "MEDIA_*", "PREVIEW_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "API_PORT",
        "API_BASE_URL",
        "JWT_*",
        "SEED_ADMIN_*",
        "REDIS_URL",
        "S3_*",
        "MEDIA_*",
        "PREVIEW_*"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "DATABASE_URL",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "REDIS_URL",
        "S3_*",
        "MEDIA_*",
        "PREVIEW_*"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
