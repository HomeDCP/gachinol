# ─────────────────────────────────────────────────────────
# Gachinol 모노레포 .gitignore
# Node/TypeScript · React Native(Expo) · NestJS · Python(AI worker)
# ─────────────────────────────────────────────────────────

# 의존성
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 빌드 산출물
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# 환경변수 / 시크릿  (⚠️ 절대 커밋 금지)
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist
service-account*.json

# 로그
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── React Native / Expo ──
.expo/
.expo-shared/
*.jks
web-build/
# iOS
ios/Pods/
ios/build/
ios/.xcode.env.local
*.xcuserstate
# Android
android/.gradle/
android/app/build/
android/build/
android/local.properties
*.hprof

# ── Python (ai-worker) ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 미디어 / 대용량 산출물 (원본·트랜스코딩은 오브젝트 스토리지에) ──
*.mp4
*.mov
*.mkv
*.m4v
*.ts
!**/src/**/*.ts
*.m3u8
tmp/
temp/
uploads/
media-cache/

# ── 데이터베이스 / 인프라 로컬 볼륨 ──
*.sqlite
*.sqlite3
pgdata/
redis-data/
minio-data/

# ── 에디터 / OS ──
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
*.swp
*~

# ── 테스트 / 커버리지 ──
coverage/
.nyc_output/
